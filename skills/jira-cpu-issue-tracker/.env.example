# JIRA CPU Issue Tracker — environment configuration
# Copy to .env and fill in your values. Never commit .env to git.

# JIRA Personal Access Token (Bearer auth)
# Generate at: https://jira.devtools.intel.com → Profile → Personal Access Tokens
JIRA_PAT=your_jira_pat_here

# JIRA instance URL (optional — defaults to Intel JIRA)
# JIRA_URL=https://jira.devtools.intel.com

# Project and component (optional — override defaults)
# JIRA_PROJECT=CVS
# JIRA_COMPONENT=IE CPU Plugin

# Corporate proxy (optional — set if behind Intel proxy)
# HTTPS_PROXY=http://child-prc.intel.com:913
# HTTP_PROXY=http://child-prc.intel.com:913
